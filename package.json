{
  "name": "my-site",
  "type": "module",
  "version": "1.0.2",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test 'src/lib/**/*.test.ts' 'src/lib/**/*.test.mjs'",
    "postbuild": "if [ -d dist ] && [ \"$(find dist -type f -name '*.html' | wc -l)\" -gt 0 ]; then pagefind --site dist; else echo 'No static HTML to index, skipping pagefind'; fi"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/netlify": "^6.6.0",
    "@astrojs/node": "^9.4.2",
    "@astrojs/sitemap": "^3.5.0",
    "@astrojs/svelte": "7.2.5",
    "@iconify-json/lucide": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.18",
    "@iconify/utils": "^2.2.1",
    "@observablehq/plot": "0.6.17",
    "@shikijs/themes": "^1.26.1",
    "astro": "^5.13.2",
    "astro-expressive-code": "^0.38.3",
    "beautiful-mermaid": "1.1.3",
    "katex": "0.16.47",
    "linkedom": "0.18.13",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "^0.33.5",
    "svelte": "5.57.2",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.3.0",
    "pagefind": "^1.3.0",
    "shiki": "^1.26.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.4"
  }
}
