{
  "name": "my-site",
  "type": "module",
  "version": "1.0.2",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9.0.0 <=14.0.1": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "if [ -d dist ] && [ \"$(find dist -type f -name '*.html' | wc -l)\" -gt 0 ]; then pagefind --site dist; else echo 'No static HTML to index, skipping pagefind'; fi"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/sitemap": "^3.7.6",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/utils": "^3.1.7",
    "@shikijs/themes": "^4.6.0",
    "astro": "^7.4.13",
    "astro-expressive-code": "^0.44.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
