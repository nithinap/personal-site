---
import Icon from "./Icon.astro";
import { name } from 'spectre:globals';

const path = Astro.url.pathname;
---
<nav aria-label="Main navigation">
  <a class="site-title" href="/">
    <span class="brand-mark" aria-hidden="true">AP</span>
    <span>{name}</span>
  </a>
  <ul id="site-navigation-links">
    <li>
      <a href="/#about" class:list={{ active: path === '/' }}>About</a>
    </li>
    <li>
      <a href="/#experience">Experience</a>
    </li>
    <li>
      <a href="/blog" class:list={{ active: path.startsWith('/blog') }}>Blog</a>
    </li>
    <li>
      <a href="/projects" class:list={{ active: path.startsWith('/projects') }}>Projects</a>
    </li>
    <li>
      <a href="/#contact">Contact</a>
    </li>
    <li class="search-item">
      <div class="search-control">
        <Icon type="lucide" name="search" width={16} height={16} />
        <input id="search" type="text" placeholder="Search (Ctrl+K)" aria-label="Search this site" />
      </div>
      <div id="search-results"></div>
    </li>
  </ul>
  <button class="mobile-nav-toggle" aria-label="Toggle navigation" aria-controls="site-navigation-links" aria-expanded="false">
    <Icon type="lucide" name="menu" width={24} height={24} class="menu-closed" />
    <Icon type="lucide" name="x" width={24} height={24} class="menu-open" />
  </button>
</nav>
<script is:inline>
  const searchElement = document.querySelector('#search');
  const results = document.querySelector('#search-results');
  const navToggle = document.querySelector('.mobile-nav-toggle');

  let focusIndex = -1;

  document.addEventListener('keydown', (e) => {
    if (e.key === 'k' && e.ctrlKey) {
      searchElement.focus();
    }

    if (e.key === 'Escape') {
      searchElement.blur();
      results.classList.remove('active');
      focusIndex = -1;
    }

    if (e.key === 'ArrowDown') {
      e.preventDefault();

      focusIndex++;
      const results = document.querySelectorAll('#search-results a');

      if (focusIndex >= results.length) {
        focusIndex = 0;
      }

      results[focusIndex]?.focus();
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();

      focusIndex--;
      const results = document.querySelectorAll('#search-results a');

      if (focusIndex < 0) {
        focusIndex = results.length - 1;
      }

      results[focusIndex]?.focus();
    }
  });

  let pagefindInitialized = false;

  searchElement?.addEventListener('focus', async () => {
    searchElement.placeholder = '';
    results.classList.add('active');
    
    // initialize pagefind on first focus
    if (!pagefindInitialized) {
      try {
        window.pagefind = await import("/pagefind/pagefind.js");
        await window.pagefind.init();
        pagefindInitialized = true;
      } catch (error) {
        console.error('Failed to initialize Pagefind:', error);
      }
    }
  });
  
  searchElement?.addEventListener('blur', () => {
    handleTabletChange();
    setTimeout(() => {
      if (!document.activeElement?.closest('#search-results')) {
        results.classList.remove('active');
        focusIndex = -1;
      }
    }, 1);
  });

  results?.addEventListener('focusout', (e) => {
    if (!e.relatedTarget?.closest('#search-results')) {
      results.classList.remove('active');
      focusIndex = -1;
    }
  });

  searchElement?.addEventListener('input', async (e) => {
    // only search if Pagefind is ready
    if (!pagefindInitialized) {
      return;
    }

    results.innerHTML = '';
    let searchResultHtml = '';

    const search = await window.pagefind.search(e.target.value);

    let i = 0;
    for (const result of search.results) {
      i++;

      const data = await result.data();
      
      searchResultHtml += `
        <a href="${data.url}">
          <h3 class="no-mt">${data.meta.title}</h3>
          <p>${data.excerpt}</p>
        </a>
        ${i < search.results.length ? '<hr class="separator">' : ''}
      `;
    }

    if (search.results.length === 0 && e.target.value.length > 0) {
      results.innerHTML = '<p style="margin-top: 0;">No results found</p>';
    } else {
      results.innerHTML = searchResultHtml;
    }

    results.classList.add('active');
  });

  navToggle?.addEventListener('click', () => {
    navToggle.classList.toggle('active');
    const isOpen = document.querySelector('nav').classList.toggle('active');
    navToggle.setAttribute('aria-expanded', String(isOpen));
  });

  const handleTabletChange = () => {
    if (window.matchMedia('(max-width: 640px)').matches) {
      searchElement.placeholder = 'Search';
    } else {
      searchElement.placeholder = 'Search (Ctrl+K)';
    }
  }

  document.addEventListener('DOMContentLoaded', handleTabletChange);
  document.addEventListener('resize', handleTabletChange);
</script>
<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    font-family: 'Geist', Arial, Helvetica, sans-serif;
    position: relative;
    z-index: 50;
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    color: var(--text);
    text-decoration: none;
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .06em;
    z-index: 2;
  }

  .site-title:hover,
  .site-title:focus-visible {
    color: var(--text);
    background: transparent;
  }

  .brand-mark {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid #586846;
    border-radius: 50%;
    color: var(--primary);
    font: .65rem 'Geist Mono', monospace;
    letter-spacing: 0;
  }

  nav ul {
    display: flex;
    gap: .2rem;
    margin: 0;
    padding: 0;
    list-style-type: none;
    align-items: center;
  }

  nav ul li {
    position: relative;
  }

  nav a {
    display: block;
    color: #c5c9bf;
    text-decoration: none;
    padding: .45rem .65rem;
    border-radius: 5px;
    font-size: .8rem;
    transition: color .15s ease, background-color .15s ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    color: var(--primary);
    background-color: rgba(var(--primary-rgb), .06);
    outline: none;
    text-decoration: none;
  }

  nav > .site-title {
    display: flex;
    flex: 0 0 auto;
    min-width: max-content;
    padding: 0;
    border-radius: 0;
    white-space: nowrap;
  }

  nav > .site-title:hover,
  nav > .site-title:focus-visible {
    color: var(--text);
    background: transparent;
  }

  .search-item {
    margin-left: .55rem;
  }

  .search-control {
    display: flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .55rem;
    border: 1px solid #394034;
    border-radius: 6px;
    color: #929a88;
  }

  .search-control:focus-within {
    border-color: #63754d;
  }

  #search {
    width: 150px;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font-size: .75rem;
  }

  #search::placeholder {
    color: #a0a697;
  }

  #search:focus {
    background: transparent;
  }

  #search-results {
    position: absolute;
    top: calc(100% + .55rem);
    right: 0;
    display: none;
    width: min(360px, calc(100vw - 2rem));
    padding: .6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background-color: var(--surface);
    box-shadow: 0 16px 40px rgba(0, 0, 0, .3);
    z-index: 10;
  }

  #search-results.active:has(*) {
    display: block;
  }

  .mobile-nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    color: var(--text);
    cursor: pointer;
    z-index: 2;
  }

  .menu-open {
    display: none;
  }

  .mobile-nav-toggle.active .menu-open {
    display: flex;
  }

  .mobile-nav-toggle.active .menu-closed {
    display: none;
  }

  @media screen and (max-width: 800px) {
    nav {
      padding-bottom: .8rem;
    }

    .mobile-nav-toggle {
      display: flex;
    }

    nav > ul {
      display: none;
    }

    nav.active > ul {
      display: flex;
      flex-direction: column;
      position: absolute;
      width: min(360px, calc(100vw - 2rem));
      top: calc(100% + .6rem);
      right: 0;
      padding: .7rem;
      border: 1px solid var(--line);
      border-radius: 9px;
      background-color: var(--surface);
      box-shadow: 0 16px 40px rgba(0, 0, 0, .3);
      align-items: stretch;
      z-index: 20;
    }

    nav ul li {
      border-bottom: 1px solid var(--line);
      width: 100%;
    }

    nav ul li:last-child {
      border-bottom: 0;
    }

    nav ul li a {
      padding: .75rem .65rem;
    }

    .search-item {
      margin: 0;
      padding-top: .55rem;
    }

    .search-control {
      min-height: 2.6rem;
      padding: .55rem .65rem;
    }

    #search {
      width: 100%;
    }

    #search-results {
      width: 100%;
      top: calc(100% + .45rem);
    }
  }
</style>
<style is:global>
  #search-results a {
    display: block;
    text-decoration: none;
    color: var(--text) !important;
    padding: .5rem;
    border-radius: 5px;
  }

  #search-results a:hover, #search-results a:focus-visible {
    background-color: rgba(var(--primary-rgb), .09);
    outline: none;
  }

  #search-results a:hover mark, #search-results a:focus-visible mark {
    background-color: var(--primary);
    color: #172012;
  }

  #search-results a h3 {
    margin-bottom: .5rem;
  }

  #search-results a p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #search-results mark {
    background-color: var(--primary);
    color: #172012;
  }

  .separator {
    margin: .5rem .5rem;
    border: none;
    height: 1px;
    background-color: var(--line);
  }
</style>
